# PostgreSQL connection settings — used by docker-compose and the loader to connect to the local DB
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_PORT=5433

# Chess.com API requires a descriptive User-Agent with contact info (see their API docs)
CHESS_API_USER_AGENT=your-app-name your-email@example.com

AIRFLOW_UID=50000
FERNET_KEY=your_code
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW_CONN_POSTGRES_DWH=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Superset metadata DB
SUPERSET_USER=your_superset_db_username
SUPERSET_PASSWORD=your_superset_db_password
SUPERSET_DB=your_superset_db_name

# Superset app settings
SUPERSET_SECRET_KEY=your_generated_secret_key
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=your_admin_password