# PostgreSQL connection settings — used by docker-compose and the loader to connect to the local DB
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_PORT=5433

# Chess.com API requires a descriptive User-Agent with contact info (see their API docs)
CHESS_API_USER_AGENT=your-app-name your-email@example.com